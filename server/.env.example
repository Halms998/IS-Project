# Copy this file to .env and fill it in. Never commit .env.

# Port the API listens on.
PORT=3001

# Secret that protects the admin routes (create election, run tally, read audit log).
# Required. Use a long random value, at least 16 characters, for example:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# SQLite database file and the folder where each election's key and token files live.
# Election folders contain private keys: keep them out of source control.
DATABASE_PATH=./data/ballot.db
DATA_DIR=./data/elections

# Folder that contains the compiled C++ programs (admin-keygen, admin-tokens,
# cast-vote, tally-votes). The default is the repository root.
CRYPTO_BIN_DIR=..

# Windows only: folder with the MSYS2 DLLs the C++ programs need, so they start when
# launched from Node. Typically C:\msys64\ucrt64\bin. Leave empty on Linux and macOS.
CRYPTO_DLL_DIR=

# How long a single C++ program may run before it is stopped (milliseconds).
CRYPTO_TIMEOUT_MS=120000
